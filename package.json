{
  "name": "dio-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Living Telegram Agent: собеседник с характером, памятью и отношениями",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:create": "node-pg-migrate create -m migrations",
    "turn": "tsx src/scripts/enqueue-turn.ts",
    "feed": "tsx src/scripts/feed.ts",
    "fake-model": "tsx src/scripts/fake-model-server.ts",
    "intend": "tsx src/scripts/intend.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
