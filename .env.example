# Скопируй в .env и заполни. .env в git не попадает.

# PostgreSQL (поднимается: docker compose up -d)
# Порт 5433, потому что на этой машине локальный postgres-сервис занимает 5432.
POSTGRES_USER=dio
POSTGRES_PASSWORD=dio
POSTGRES_DB=dio
POSTGRES_PORT=5433
DATABASE_URL=postgres://dio:dio@localhost:5433/dio

# Приложение
NODE_ENV=development
LOG_LEVEL=info

# Потолок соединений приложения к PostgreSQL (18.5): при насыщении (открытые
# курсоры + фоновые задачи + доставка) пул не должен расти незаметно до лимита
# сервера. Пусто — 8. Ожидание свободного соединения ограничено 5 секундами
# (не настраивается): насыщение пула становится обычной ошибкой запроса, её
# подхватывают ретраи циклов — worker/доставка/фон не зависают молча.
# DB_MAX_CONNS=8

# HTTP-метрики §20 (этап 31). Сервер слушает только 127.0.0.1 (наружу не
# выставляется). Пусто — выключен. /metrics — Prometheus text exposition,
# /stats — читаемый JSON, /healthz — проверка живости (пинг базы).
# METRICS_PORT=9100

# Раскадровка гифок и кружков (этап 35): внешний ffmpeg режет видео на 4–6
# кадров для модели. Пусто — поиск ffmpeg в PATH, затем $HOME/.local/bin/ffmpeg.
# Не найден — раскадровка выключена, видео идёт превью-кадром (ход работает).
# FFMPEG_PATH=/usr/bin/ffmpeg

# Веб (§15, этап 36): по умолчанию выключен. ddg — поиск DuckDuckGo без ключа,
# tavily — по ключу. Инструменты получают explore фона и разговорный ход
# (≤2 поиска + 2 страницы за ход, ≤15 поисков/сутки на разговор, UTC).
# Картинки хода (image_url) качаются тем же fetch-слоем: image/jpeg|png|webp|gif,
# потолок 5 МиБ, те же SSRF-проверки.
# WEB_SEARCH_PROVIDER=off
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5
# WEB_FETCH_MAX_BYTES=262144
# WEB_FETCH_TIMEOUT_MS=20000
# WEB_MAX_SEARCH_PER_TASK=2
# WEB_MAX_FETCH_PER_TASK=3

# Telegram Bot API (создать у @BotFather)
# Локальная отладка без токена: TELEGRAM_DRY_RUN=true — отправки пишутся в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DRY_RUN=false
# TELEGRAM_API_BASE=https://api.telegram.org

# Модельный адаптер (этап 1.6). Стартовый endpoint — OpenCode Go,
# запасной — OpenRouter; переключение — правкой этих переменных.
# Точный base URL OpenCode Go возьми в консоли OpenCode (Console → Go → API key).
MODEL_ENDPOINT=
MODEL_API_KEY=
MODEL_MODEL=
# Недавний разговор в контексте каждого хода (8.1): сколько последних сообщений
# обеих сторон брать и какой суммарный объём текста допустим (самые старые
# обрезаются первыми). 1000 сообщений — ориентир «помнит весь день общения».
# MODEL_HISTORY_MESSAGES=1000
# MODEL_HISTORY_MAX_CHARS=200000
# Лимит обращений к инструментам памяти за один ход (§11.2/§17): лишние вызовы
# модель видит отказом и завершает ход финальным ответом.
# MODEL_TOOL_CALLS_LIMIT=5
# Предзагрузка памяти (решение 2026-11-02): харнесс собирает карточку
# собеседника в панель состояния, и на целом разговоре инструменты памяти не
# выдаются. false — откат: карточки нет, инструменты всегда, forced на прямом
# ходе. Пусто — true.
# MODEL_MEMORY_PREFETCH=true
# Дамп модельных вызовов (этап 40.1): каталог, куда на каждый модельный
# вызов (чат-ход и фон) пишется пара request/response
# (turn-<id>-call-<n>.json, фон — bg-<task>-call-<n>.json). Ключи API
# (Authorization/x-api-key/cookie, секреты в query) не пишутся, файлы 0600,
# каталог 0700, ретенция 3 дня. Пусто — выключен (обычный режим).
# MODEL_DEBUG_DUMP_DIR=/var/lib/dio/dumps
# Часовой пояс абсолютных меток истории/панели (IANA). Пусто — Europe/Moscow.
# AGENT_TIMEZONE=Europe/Moscow

# Векторизатор для семантического поиска памяти (этап 9.3, §10.4): любой
# OpenAI-совместимый endpoint (POST {EMBEDDING_ENDPOINT}/embeddings).
# Не настроен — семантический поиск выключен, full-text поиск остаётся.
# Боевая настройка — neuraldeep, модель bge-m3 (1024d); ключ — плейсхолдер.
# EMBEDDING_ENDPOINT=https://api.neuraldeep.ru/v1
# EMBEDDING_API_KEY=__PLACEHOLDER__
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_TIMEOUT_MS=30000

# Дневной лимит пула background (§16) отдельно от общего: фон (§15, инициативы,
# консолидации) не должен выжечь день и оставить прямые разговоры без бюджета
# (инцидент 2026-10-31: 1000/1000 вызовов за неполный день). Пусто — как
# MODEL_DAILY_CALLS_LIMIT.
MODEL_BACKGROUND_CALLS_LIMIT=400
